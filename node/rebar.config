{erl_opts, [
    nowarn_deprecated_function,
    nowarn_deprecated_catch,
    warn_export_all,
    warn_export_vars,
    % warn_untyped_record, % disabled because we include luerl.hrl
    warn_unused_import,
    warnings_as_errors
]}.

{sub_dirs, ["apps/*", "rel", "deps"]}.

{deps, [
        {netlink, ".*", {git, "https://github.com/alesasnouski/netlink.git", {ref, "022faada7fbd136293d46ef2df84e05baabb3e1f"}}},
        {ranch, "2.3.0"},
        {jiffy, "2.0.2"},
        {luerl, "1.5.1"},
        {hdr_histogram, "0.5.0"}]}.

{deps_dir, "deps"}.
{lib_dirs, ["deps", "apps"]}.
{eunit_opts, [verbose]}.
{eunit_tests, [
    {application, mzbench},
    {application, mz_histogram},
    {application, mz_counter},
    {application, dummy_worker}
]}.

{project_app_dirs, ["apps/*", "../common_apps/*"]}.

{overrides, [
    {override, hdr_histogram, [
        {pre_hooks, [
            {"(linux|solaris)", compile,
                "env ERTS_INCLUDE_DIR=$(erl -noshell -eval 'io:put_chars(code:root_dir() ++ \"/erts-\" ++ erlang:system_info(version) ++ \"/include/\"), halt().') ERL_INTERFACE_INCLUDE_DIR=$(erl -noshell -eval 'io:put_chars(code:lib_dir(erl_interface, include)), halt().') ERL_INTERFACE_LIB_DIR=$(erl -noshell -eval 'io:put_chars(code:lib_dir(erl_interface, lib)), halt().') make -C c_src"},
            {"darwin", compile,
                "env ERTS_INCLUDE_DIR=$(erl -noshell -eval 'io:put_chars(code:root_dir() ++ \"/erts-\" ++ erlang:system_info(version) ++ \"/include/\"), halt().') ERL_INTERFACE_INCLUDE_DIR=$(erl -noshell -eval 'io:put_chars(code:lib_dir(erl_interface, include)), halt().') ERL_INTERFACE_LIB_DIR=$(erl -noshell -eval 'io:put_chars(code:lib_dir(erl_interface, lib)), halt().') CFLAGS='-O3 -std=c99 -finline-functions -Wall -Wmissing-prototypes' CXXFLAGS='-O3 -finline-functions -Wall' LDFLAGS='-flat_namespace -undefined suppress' make -C c_src"}
        ]}
    ]}
]}.

{minimum_otp_vsn, "29.0"}.

{dialyzer, [
    {warnings, [
        error_handling,
        no_undefined_callbacks,
        race_conditions,
        underspecs,
        no_superspecs,
        unmatched_returns
        ]}
    ]}.

{relx, [
    {release, {mzbench, "0.6.0"},
        [mzbench, dummy_worker, mz_histogram, mz_counter,
        crypto, public_key, asn1, ssl, inets]},
    {vm_args, "rel/files/vm.args"},
    {sys_config, "rel/files/sys.config"},
    {include_erts, true},
    {generate_start_script, false},
    {overlay, [
            {copy, "rel/files/mzbench", "bin/mzbench"},
            {copy, "rel/files/mzbench.cmd", "bin/mzbench.cmd"},
            {copy, "rel/files/erl", "bin/erl"},
            {copy, "rel/files/install_upgrade.escript", "bin/install_upgrade.escript"},
            {copy, "rel/files/nodetool", "bin/nodetool"},
            {copy, "scripts/wait_cluster_start.escript", "bin/wait_cluster_start.escript"},
            {copy, "scripts/run_local.escript", "bin/run_local.escript"}
        ]}
    ]}.
