{erl_opts, [
    nowarn_deprecated_function,
    warn_export_all,
    warn_export_vars,
    warn_untyped_record,
    warn_unused_import,
    warnings_as_errors
]}.

{profiles, [
    {test, [
        {erl_opts, [nowarn_missing_spec]}
    ]}
]}.

{deps, [
        {pretty_errors,
            {git, "https://github.com/ethercrow/pretty_errors.git",
                {ref, "531d79b0057c3b08b8509b326b9bdaf663bf45ce"}}},
        {jiffy, "2.0.2"}
        ]}.

{project_app_dirs, [".", "../mzbench_utils"]}.

{deps_dir, "deps"}.
{lib_dirs, ["deps"]}.
{eunit_opts, [verbose]}.
{minimum_otp_vsn, "29.0"}.
