{erl_opts, [
    nowarn_deprecated_function,
    warn_export_all,
    warn_export_vars,
    warn_untyped_record,
    warn_unused_import,
    warnings_as_errors,
    {d, 'USE_STRONG_RAND_BYTES'}
]}.

{deps, []}.

{deps_dir, "deps"}.
{lib_dirs, ["deps"]}.
{eunit_opts, [verbose]}.

{minimum_otp_vsn, "29.0"}.

{dialyzer, [
    {warnings, [
        error_handling,
        no_undefined_callbacks,
        race_conditions,
        underspecs,
        unmatched_returns
        ]}
    ]}.
